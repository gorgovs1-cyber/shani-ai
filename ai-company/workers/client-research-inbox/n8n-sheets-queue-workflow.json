    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const req = ($('Webhook: Claim').first().json.body) || {};\nconst rows = $input.all().map(i => i.json).filter(r => r && r.submission_id);\nconst now = Date.now();\nconst staleMin = Number(req.stale_minutes || 120);\nif ((req.action || 'claim') === 'reclaim_stale') {\n  const jobs = rows.filter(r => r.status === 'processing' && r.locked_at && (now - Date.parse(r.locked_at)) > staleMin * 60000);\n  return [{ json: { mode: 'respond_only', response: { jobs } } }];\n}\nconst eligible = rows\n  .filter(r => r.status === 'pending' && (!r.next_attempt_at || Date.parse(r.next_attempt_at) <= now))\n  .sort((a, b) => String(a.created_at).localeCompare(String(b.created_at)));\nif (!eligible.length) return [{ json: { mode: 'respond_only', response: { job: null } } }];\nconst row = eligible[0];\nconst lockedAt = new Date().toISOString();\nconst lockedBy = req.worker_id || 'runner';\nreturn [{ json: {\n  mode: 'claim',\n  response: { job: { ...row, status: 'processing', locked_at: lockedAt, locked_by: lockedBy } },\n  update: { submission_id: row.submission_id, status: 'processing', locked_at: lockedAt, locked_by: lockedBy, updated_at: lockedAt }\n} }];"
      },

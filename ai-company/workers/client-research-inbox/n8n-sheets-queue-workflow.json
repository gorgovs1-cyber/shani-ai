        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const row = $input.first().json || {};\nconst meta = new Set(['submissionId', 'receivedAt', 'source', 'payloadVersion', 'processingStatus', 'row_number']);\nconst answers = {};\nfor (const [k, v] of Object.entries(row)) if (!meta.has(k)) answers[k] = v;\nconst submissionId = row.submissionId || ('SUB-' + Date.now());\nconst nowIso = new Date().toISOString();\nreturn [{ json: {\n  submission_id: submissionId,\n  created_at: row.receivedAt || nowIso,\n  updated_at: nowIso,\n  status: 'pending',\n  attempts: 0,\n  locked_at: '', locked_by: '', next_attempt_at: '',\n  client_id: '', report_path: '', review_status: '',\n  shani_status: 'pending', error_code: '', error_message: '',\n  envelope_json: JSON.stringify({ submissionId, receivedAt: row.receivedAt || nowIso, source: 'sheets-queue', payloadVersion: 1, answers })\n} }];"
      },

      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const b = ($input.first().json.body) || {};\nif (!b.submission_id) return [{ json: { __invalid: true } }];\nconst out = { __invalid: false, submission_id: b.submission_id, updated_at: new Date().toISOString() };\nconst allowed = ['status','attempts','locked_at','locked_by','next_attempt_at','client_id','report_path','review_status','shani_status','error_code','error_message'];\nfor (const k of allowed) if (b.patch && k in b.patch) out[k] = (b.patch[k] === null || b.patch[k] === undefined) ? '' : String(b.patch[k]);\nreturn [{ json: out }];"
      },
